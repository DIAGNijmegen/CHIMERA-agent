# ============================================================================
# LLM-Biopsy-Decision Evaluator — environment configuration
#
# Copy this file to .env and adjust for your system.
# ./do_test_run.sh sources ./.env automatically.  You can also export any of
# these in your shell before running the scripts.
# ============================================================================

# ── GPU ──────────────────────────────────────────────────────────────────────

# Which GPU index to expose to the container (check available GPUs with
# `nvidia-smi`).  Comment-out / unset for a CPU-only run, and also set
# USE_RATIONALE_JUDGE=0 below.
GPU_DEVICE_ID=0

# ── Evaluation inputs and mount paths (host side) ───────────────────────────

# Task directory to evaluate. With the Grand-Challenge mount contract the
# evaluator reads:
#   /opt/ml/input/data/ground_truth/section_variable_mapping.json
#   /opt/ml/input/data/ground_truth/$TASK_ID/<case_id>/pathologist_response.json
#   /input/predictions.json
#   /input/<job_pk>/<output file named by the socket relative_path>
# Locally these are bind-mounted from ./ground_truth and ./test/input.
TASK_ID=task1

# ── Judge LLM ────────────────────────────────────────────────────────────────

# Ollama model tag used as the rationale judge. This tag is baked into the
# image at build time, so changing it here alone is not enough — rebuild with
# JUDGE_MODEL=<tag> ./do_build.sh
JUDGE_MODEL=gemma4:e4b

# Set to 0 to skip the LLM-judge step (fully deterministic, no GPU required).
USE_RATIONALE_JUDGE=1

# The judge weights ship inside the image, so runs are offline by default and
# ALLOW_MODEL_PULL=0 is correct. Set to 1 only to fetch a different tag at
# runtime, which also requires dropping --network none from do_test_run.sh.
ALLOW_MODEL_PULL=0
